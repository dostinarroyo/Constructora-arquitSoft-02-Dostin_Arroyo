flowchart LR
    browser["Navegador web"]

    subgraph entrada["PRESENTACIÓN Y SEGURIDAD"]
        direction TB
        controller["Controladores web<br/>Validan entrada y respuesta"]
        security["Spring Security<br/>Autenticación y permisos"]
        controller --> security
    end

    subgraph application["APLICACIÓN"]
        direction TB
        subgraph modules["MÓDULOS DE NEGOCIO"]
            direction TB
            projects["Proyectos y actividades"]
            warehouse["Materiales y almacén"]
            people["Personal y asignaciones"]
            equipment["Maquinaria"]
            finance["Finanzas"]
            reports["Reportes y panel"]
            users["Usuarios y roles"]
        end
        usecases["Casos de uso<br/>Coordinan operaciones"]
    end

    subgraph domain["DOMINIO"]
        direction TB
        entities["Entidades y reglas<br/>de negocio"]
        ports["Contratos<br/>de repositorio"]
    end

    subgraph infrastructure["INFRAESTRUCTURA"]
        direction TB
        adapters["Adaptadores<br/>de persistencia"]
        db[("MySQL")]
        adapters --> db
    end

    browser --> controller
    security --> usecases
    usecases --> modules
    modules --> entities
    modules --> ports
    adapters -. "implementan contratos" .-> ports

    classDef user fill:#f4f4f5,stroke:#52525b,color:#18181b,stroke-width:1.5px
    classDef presentationStyle fill:#e7f0ff,stroke:#2563a6,color:#17365d,stroke-width:1.5px
    classDef applicationStyle fill:#e9f7ef,stroke:#2d8a57,color:#14532d,stroke-width:1.5px
    classDef domainStyle fill:#fff3df,stroke:#c27a12,color:#713f12,stroke-width:1.5px
    classDef infrastructureStyle fill:#f2eaff,stroke:#7646b8,color:#4c1d95,stroke-width:1.5px

    class browser user
    class controller,security presentationStyle
    class projects,warehouse,people,equipment,finance,reports,users,usecases applicationStyle
    class entities,ports domainStyle
    class adapters,db infrastructureStyle
