flowchart LR
    U["Actores internos autorizados"]

    subgraph PRESENTACION["CAPA DE PRESENTACIÓN"]
        direction TB
        WEB["Interfaz web<br/>Formularios · Consultas<br/>Panel · Reportes"]
    end

    subgraph APLICACION["CAPA DE APLICACIÓN"]
        direction TB
        CTRL["Controladores<br/>Puntos de entrada"]
        AUTH["Autenticación y autorización<br/>Permisos por rol"]
        SERV["Servicios de aplicación<br/>Reglas de negocio"]
        MOD["Módulos<br/>Proyectos · Actividades · Almacén<br/>Personal · Maquinaria · Finanzas<br/>Reportes · Usuarios"]
        CTRL --> AUTH --> SERV --> MOD
    end

    subgraph DATOS["ACCESO A DATOS"]
        direction TB
        REPO["Repositorios<br/>Contratos y persistencia"]
    end

    subgraph PERSISTENCIA["PERSISTENCIA"]
        direction TB
        DB[("MySQL<br/>Base de datos central")]
    end

    U --> WEB --> CTRL
    MOD --> REPO --> DB

    classDef user fill:#f4f4f5,stroke:#52525b,color:#18181b,stroke-width:1.5px
    classDef presentation fill:#e7f0ff,stroke:#2563a6,color:#17365d,stroke-width:1.5px
    classDef application fill:#e9f7ef,stroke:#2d8a57,color:#14532d,stroke-width:1.5px
    classDef data fill:#fff3df,stroke:#c27a12,color:#713f12,stroke-width:1.5px
    classDef persistence fill:#e6faff,stroke:#0891b2,color:#164e63,stroke-width:1.5px

    class U user
    class WEB presentation
    class CTRL,AUTH,SERV,MOD application
    class REPO data
    class DB persistence
