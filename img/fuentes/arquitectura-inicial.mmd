flowchart LR
    U["Actores internos autorizados"]

    subgraph PRESENTACION["CAPA DE PRESENTACIÓN"]
        direction TB
        WEB["Interfaz web<br/>Formularios · Consultas<br/>Panel · Reportes"]
        CTRL["Controladores<br/>Puntos de entrada"]
    end

    subgraph APLICACION["APLICACIÓN"]
        direction TB
        USECASE["Casos de uso<br/>Coordinar operaciones"]
        PORT["Puertos requeridos<br/>Contratos de repositorio"]
    end

    subgraph DOMINIO["DOMINIO"]
        direction TB
        RULES["Entidades y reglas<br/>de negocio"]
    end

    subgraph INFRAESTRUCTURA["INFRAESTRUCTURA"]
        direction TB
        ADAPTER["Adaptadores de persistencia<br/>Spring Security"]
        DB[("MySQL<br/>Base de datos central")]
        ADAPTER --> DB
    end

    U --> WEB --> CTRL --> USECASE
    USECASE --> RULES
    ADAPTER -. "implementa" .-> PORT

    classDef user fill:#f4f4f5,stroke:#52525b,color:#18181b,stroke-width:1.5px
    classDef presentation fill:#e7f0ff,stroke:#2563a6,color:#17365d,stroke-width:1.5px
    classDef application fill:#e9f7ef,stroke:#2d8a57,color:#14532d,stroke-width:1.5px
    classDef domain fill:#fff3df,stroke:#c27a12,color:#713f12,stroke-width:1.5px
    classDef infrastructure fill:#f2eaff,stroke:#7646b8,color:#4c1d95,stroke-width:1.5px

    class U user
    class WEB presentation
    class USECASE,PORT application
    class RULES domain
    class ADAPTER,DB infrastructure
