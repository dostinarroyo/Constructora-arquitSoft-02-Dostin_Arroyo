classDiagram
    direction LR

    class SalidaMaterialController {
        +solicitarSalida(SolicitudSalida) ResultadoSalida
        +presentarResultado(ResultadoSalida) ResponseEntity
    }

    class RegistrarSalidaMaterial {
        -RepositorioAlmacen repositorio
        +ejecutar(SolicitudSalida) ResultadoSalida
    }

    class SolicitudSalida {
        +Long materialId
        +Long proyectoId
        +BigDecimal cantidad
    }

    class ResultadoSalida {
        +Long materialId
        +Long proyectoId
        +BigDecimal cantidad
        +BigDecimal stockRestante
    }

    class RepositorioAlmacen {
        <<interface>>
        +buscarMaterial(Long) Optional~Material~
        +registrarSalida(Material, MovimientoAlmacen) void
    }

    class Material {
        -Long id
        -String nombre
        -BigDecimal stockActual
        +descontar(BigDecimal) void
    }

    class MovimientoAlmacen {
        -Long materialId
        -Long proyectoId
        -BigDecimal cantidad
        -TipoMovimiento tipo
        +salida(Long, Long, BigDecimal) MovimientoAlmacen
    }

    class TipoMovimiento {
        <<enumeration>>
        ENTRADA
        SALIDA
    }

    class AdaptadorAlmacenMySql {
        +buscarMaterial(Long) Optional~Material~
        +registrarSalida(Material, MovimientoAlmacen) void
    }

    class MySQL {
        <<database>>
        Materiales
        Movimientos
    }

    SalidaMaterialController --> RegistrarSalidaMaterial : solicita la operación
    SalidaMaterialController ..> SolicitudSalida : recibe
    RegistrarSalidaMaterial ..> SolicitudSalida : valida
    RegistrarSalidaMaterial ..> ResultadoSalida : devuelve
    RegistrarSalidaMaterial --> RepositorioAlmacen : consulta y registra
    RegistrarSalidaMaterial --> Material : aplica reglas de stock
    RegistrarSalidaMaterial --> MovimientoAlmacen : crea el movimiento
    MovimientoAlmacen --> TipoMovimiento : clasifica
    RepositorioAlmacen <|.. AdaptadorAlmacenMySql : implementa
    AdaptadorAlmacenMySql --> MySQL : transacción
